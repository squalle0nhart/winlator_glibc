+static bool readExact(int socket, void *data, size_t size) {
+	auto *bytes = static_cast<char *>(data);
+	while (size > 0) {
+		ssize_t count = read(socket, bytes, size);
+		if (count < 0) {
+			if (errno == EINTR)
+				continue;
+			return false;
+		}
+		if (count == 0)
+			return false;
+		bytes += count;
+		size -= static_cast<size_t>(count);
+	}
+	return true;
+}
+
+static bool writeSocket(int socket, const void *data, size_t size) {
+	const auto *bytes = static_cast<const char *>(data);
+	while (size > 0) {
+		ssize_t written = send(socket, bytes, size, MSG_NOSIGNAL);
+		if (written < 0) {
+			if (errno == EINTR)
+				continue;
+			return false;
+		}
+		if (written == 0)
+			return false;
+		bytes += written;
+		size -= static_cast<size_t>(written);
+	}
+	return true;
+}
